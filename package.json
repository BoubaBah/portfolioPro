{
  "name": "build-and-launch",
  "private": true,
  "scripts": {
    "build": "node scripts/build-projects.mjs && npm run build:css",
    "build:css": "tailwindcss -i src/input.css -o assets/styles.css --minify",
    "projects": "node scripts/build-projects.mjs",
    "dev": "tailwindcss -i src/input.css -o assets/styles.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.1.0",
    "lenis": "^1.3.26",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.0"
  }
}
